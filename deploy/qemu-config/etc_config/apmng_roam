config roam 'roam'
	list 2g_roaming_threshold_type 'rssi'
	list 5g_roaming_threshold_type 'rssi'
	option 11k_switch 'on'
	option 11v_switch 'on'
	option 11r_switch 'on'
	option 2g_rssi_trigger_threshold '-75'
	option 2g_low_rssi_kick 'off'
	option 2g_low_rssi_threshold '-80'
	option 2g_rate_trigger_threshold '20'
	option 2g_low_rate_kick 'off'
	option 2g_low_rate_threshold '10'
	option 5g_rssi_trigger_threshold '-80'
	option 5g_low_rssi_kick 'off'
	option 5g_low_rssi_threshold '-85'
	option 5g_rate_trigger_threshold '20'
	option 5g_low_rate_kick 'off'
	option 5g_low_rate_threshold '10'
	option threshold_check_interval '1'
	option roaming_dif '8'
	option blacklist_restrict_time '2'
	option rssi_trigger_threshold_high_performance '-65'
	option stats_switch 'off'
	option stats_interval '30'

config wireless_network_mode 'wireless_network_mode'
	option wireless_network_mode '0'
	option cur_wireless_network_mode '0'
	option default_roam_cnt '3'
	option default_silence_time '30'
	option high_performance_roam_cnt '5'
	option high_performance_silence_time '15'
	option acs_timeout '5'
