config sys 'sys'
	option timezone '0'
	option is_factory 'off'
	option has_set_pwd 'on'
	option go_wizard 'off'

config time_type 'time_type'
	option type '0'

config ntp 'ntp'
	option enable_server 'on'
	option pri_ntp '0'
	option snd_ntp '0'

config service_port 'service_port'
	option https_port '0'
	option web_timeout '0'
	option http_port '0'
	option max_trytimes '0'
	option lock_time '0'
	option http_port_switch 'on'
	option https_port_switch 'on'

config syslog 'syslog'
	option level_switch 'on'
	option level '0'
	option module_switch 'on'
	option module '0'
	option log_send '0'
	option send_server '0'
	option log_size '0'
