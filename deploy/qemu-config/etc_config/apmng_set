config settings 'settings'
	option apmngr_status 'on'
	option auto_firm 'off'
	option auto_reboot 'off'
	option reboot_day '1'
	option reboot_time '3'

	option sub_proxy_enable 'on'
	option dft_offline_selfmanage 'off'
	option sub_proxy_uri '/'
	option sub_proxy_url_max_len '256'
	option sub_proxy_protocol 'http'
	option http_port '80'
	option https_port '443'
config aplog_setting 'aplog_setting'
	option ac_log_switch 'on'
	option remote_server_switch 'on'
	option ac_log_level '0'
	option remote_log_level '0'
	option remote_server '192.168.70.1'
	option remote_report_interval '0'

config crashdump_setting 'crashdump_setting'
	option enable 'on'
	option export_proto 'tftp'
	option server_ip '192.168.70.1'
	option server_port '69'
	option gateway_ip '192.168.70.1'

config ap_capture_settings 'ap_capture_settings'
	option enable 'on'
	option remote_capture_port '5000'

	option gateway_ip '192.168.70.1'
config cruise_setting 'cruise_setting'
	option enable 'on'
	option scan_time '0'
	option scan_interval '60'
