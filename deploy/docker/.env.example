# Linux host interface connected to APs; use the actual in-container veth name on RouterOS.
AC_INTERFACE=eth0
AC_PLATFORM=linux/arm64
AC_IMAGE=go-ac:latest-arm64
AC_DHCP_IMAGE=go-ac:latest-arm64-dhcp
# Host networking: this is the actual listening port; there is no ports mapping.
AC_HTTP_HOST=127.0.0.1
AC_HTTP_PORT=8090
AC_CERTS_DIR=./certs
# Used only by compose.dhcp.yml; copy and edit ap-dhcp.example.json first.
AC_DHCP_CONFIG_FILE=./ap-dhcp.json

# Go runtime soft budget, not a container RSS/OOM limit. Increase for larger deployments.
AC_GO_MEMORY_LIMIT=64MiB
